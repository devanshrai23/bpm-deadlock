<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_M3_fixed" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_M3_fixed" name="M3 Loan approval - risk routing (fixed)" isExecutable="false">
    <bpmn:startEvent id="start" name="Application received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="receive" name="Receive application">
      <bpmn:documentation>time: 5</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="assess" name="Assess risk">
      <bpmn:documentation>time: 10</bpmn:documentation>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="risk_split" name="Risk level?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="senior" name="Senior officer review">
      <bpmn:documentation>time: 30</bpmn:documentation>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="auto" name="Automatic scoring">
      <bpmn:documentation>time: 2</bpmn:documentation>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="risk_join" name="">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="decide" name="Final decision">
      <bpmn:documentation>time: 15</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="notify" name="Notify applicant">
      <bpmn:documentation>time: 3</bpmn:documentation>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Done">
      <bpmn:incoming>f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive" targetRef="assess" />
    <bpmn:sequenceFlow id="f3" sourceRef="assess" targetRef="risk_split" />
    <bpmn:sequenceFlow id="f4" name="High risk" sourceRef="risk_split" targetRef="senior" />
    <bpmn:sequenceFlow id="f5" name="Low risk" sourceRef="risk_split" targetRef="auto" />
    <bpmn:sequenceFlow id="f6" sourceRef="senior" targetRef="risk_join" />
    <bpmn:sequenceFlow id="f7" sourceRef="auto" targetRef="risk_join" />
    <bpmn:sequenceFlow id="f8" sourceRef="risk_join" targetRef="decide" />
    <bpmn:sequenceFlow id="f9" sourceRef="decide" targetRef="notify" />
    <bpmn:sequenceFlow id="f10" sourceRef="notify" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_M3_fixed">
    <bpmndi:BPMNPlane id="Plane_M3_fixed" bpmnElement="Process_M3_fixed">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="102" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="77" y="170" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="receive_di" bpmnElement="receive">
        <dc:Bounds x="215" y="185" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="assess_di" bpmnElement="assess">
        <dc:Bounds x="365" y="185" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="risk_split_di" bpmnElement="risk_split" isMarkerVisible="true">
        <dc:Bounds x="545" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="520" y="163" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="senior_di" bpmnElement="senior">
        <dc:Bounds x="665" y="65" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="auto_di" bpmnElement="auto">
        <dc:Bounds x="665" y="305" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="risk_join_di" bpmnElement="risk_join" isMarkerVisible="true">
        <dc:Bounds x="845" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decide_di" bpmnElement="decide">
        <dc:Bounds x="965" y="185" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notify_di" bpmnElement="notify">
        <dc:Bounds x="1115" y="185" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="1302" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1277" y="170" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="138" y="220" />
        <di:waypoint x="215" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="325" y="220" />
        <di:waypoint x="365" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="475" y="220" />
        <di:waypoint x="545" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="570" y="195" />
        <di:waypoint x="570" y="100" />
        <di:waypoint x="665" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="578" y="138" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="570" y="245" />
        <di:waypoint x="570" y="340" />
        <di:waypoint x="665" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="578" y="284" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="775" y="100" />
        <di:waypoint x="870" y="100" />
        <di:waypoint x="870" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="775" y="340" />
        <di:waypoint x="870" y="340" />
        <di:waypoint x="870" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
        <di:waypoint x="895" y="220" />
        <di:waypoint x="965" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9">
        <di:waypoint x="1075" y="220" />
        <di:waypoint x="1115" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10">
        <di:waypoint x="1225" y="220" />
        <di:waypoint x="1302" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
