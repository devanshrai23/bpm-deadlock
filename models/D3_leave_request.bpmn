<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_D3_leave_request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_D3_leave_request" name="D3 Leave request (AND-split closed by XOR-join: lack of synchronisation)" isExecutable="false">
    <bpmn:startEvent id="start" name="Request submitted">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="submit" name="Submit leave request">
      <bpmn:documentation>time: 5</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="split" name="">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="manager" name="Manager approval">
      <bpmn:documentation>time: 60</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="hr" name="HR balance check">
      <bpmn:documentation>time: 20</bpmn:documentation>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="join" name="">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="calendar" name="Update team calendar">
      <bpmn:documentation>time: 5</bpmn:documentation>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Leave booked">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="f2" sourceRef="submit" targetRef="split" />
    <bpmn:sequenceFlow id="f3" sourceRef="split" targetRef="manager" />
    <bpmn:sequenceFlow id="f4" sourceRef="split" targetRef="hr" />
    <bpmn:sequenceFlow id="f5" sourceRef="manager" targetRef="join" />
    <bpmn:sequenceFlow id="f6" sourceRef="hr" targetRef="join" />
    <bpmn:sequenceFlow id="f7" sourceRef="join" targetRef="calendar" />
    <bpmn:sequenceFlow id="f8" sourceRef="calendar" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_D3_leave_request">
    <bpmndi:BPMNPlane id="Plane_D3_leave_request" bpmnElement="Process_D3_leave_request">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="102" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="77" y="170" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="submit_di" bpmnElement="submit">
        <dc:Bounds x="215" y="185" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="split_di" bpmnElement="split">
        <dc:Bounds x="395" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="manager_di" bpmnElement="manager">
        <dc:Bounds x="515" y="65" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="hr_di" bpmnElement="hr">
        <dc:Bounds x="515" y="305" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_di" bpmnElement="join" isMarkerVisible="true">
        <dc:Bounds x="695" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="calendar_di" bpmnElement="calendar">
        <dc:Bounds x="815" y="185" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="1002" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="977" y="170" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="138" y="220" />
        <di:waypoint x="215" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="325" y="220" />
        <di:waypoint x="395" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="420" y="195" />
        <di:waypoint x="420" y="100" />
        <di:waypoint x="515" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="420" y="245" />
        <di:waypoint x="420" y="340" />
        <di:waypoint x="515" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="625" y="100" />
        <di:waypoint x="720" y="100" />
        <di:waypoint x="720" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="625" y="340" />
        <di:waypoint x="720" y="340" />
        <di:waypoint x="720" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="745" y="220" />
        <di:waypoint x="815" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
        <di:waypoint x="925" y="220" />
        <di:waypoint x="1002" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
