<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_D2_insurance_claim" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_D2_insurance_claim" name="D2 Insurance claim (XOR-split closed by AND-join)" isExecutable="false">
    <bpmn:startEvent id="start" name="Claim filed">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="register" name="Register claim">
      <bpmn:documentation>time: 10</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="size" name="Claim size?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="auto" name="Auto-approve small claim">
      <bpmn:documentation>time: 2</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="assess" name="Assess damage on site">
      <bpmn:documentation>time: 120</bpmn:documentation>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="join" name="">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="pay" name="Pay claim">
      <bpmn:documentation>time: 15</bpmn:documentation>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Claim closed">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="register" />
    <bpmn:sequenceFlow id="f2" sourceRef="register" targetRef="size" />
    <bpmn:sequenceFlow id="f3" name="Small" sourceRef="size" targetRef="auto" />
    <bpmn:sequenceFlow id="f4" name="Large" sourceRef="size" targetRef="assess" />
    <bpmn:sequenceFlow id="f5" sourceRef="auto" targetRef="join" />
    <bpmn:sequenceFlow id="f6" sourceRef="assess" targetRef="join" />
    <bpmn:sequenceFlow id="f7" sourceRef="join" targetRef="pay" />
    <bpmn:sequenceFlow id="f8" sourceRef="pay" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_D2_insurance_claim">
    <bpmndi:BPMNPlane id="Plane_D2_insurance_claim" bpmnElement="Process_D2_insurance_claim">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="102" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="77" y="170" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="register_di" bpmnElement="register">
        <dc:Bounds x="215" y="185" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="size_di" bpmnElement="size" isMarkerVisible="true">
        <dc:Bounds x="395" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="370" y="163" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="auto_di" bpmnElement="auto">
        <dc:Bounds x="515" y="65" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="assess_di" bpmnElement="assess">
        <dc:Bounds x="515" y="305" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_di" bpmnElement="join">
        <dc:Bounds x="695" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pay_di" bpmnElement="pay">
        <dc:Bounds x="815" y="185" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="1002" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="977" y="170" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="138" y="220" />
        <di:waypoint x="215" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="325" y="220" />
        <di:waypoint x="395" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="420" y="195" />
        <di:waypoint x="420" y="100" />
        <di:waypoint x="515" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="138" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="420" y="245" />
        <di:waypoint x="420" y="340" />
        <di:waypoint x="515" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="284" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="625" y="100" />
        <di:waypoint x="720" y="100" />
        <di:waypoint x="720" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="625" y="340" />
        <di:waypoint x="720" y="340" />
        <di:waypoint x="720" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="745" y="220" />
        <di:waypoint x="815" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
        <di:waypoint x="925" y="220" />
        <di:waypoint x="1002" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
