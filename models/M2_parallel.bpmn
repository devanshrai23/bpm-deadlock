<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_M2_parallel" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="Process_M2_parallel" name="M2 Loan approval - parallel checks" isExecutable="false">
    <bpmn:startEvent id="start" name="Application received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="receive" name="Receive application">
      <bpmn:documentation>time: 5</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="and_split" name="">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="credit" name="Credit check">
      <bpmn:documentation>time: 20</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="docs" name="Document check">
      <bpmn:documentation>time: 15</bpmn:documentation>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="and_join" name="">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="decide" name="Make decision">
      <bpmn:documentation>time: 15</bpmn:documentation>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="notify" name="Notify applicant">
      <bpmn:documentation>time: 3</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Done">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive" targetRef="and_split" />
    <bpmn:sequenceFlow id="f3" sourceRef="and_split" targetRef="credit" />
    <bpmn:sequenceFlow id="f4" sourceRef="and_split" targetRef="docs" />
    <bpmn:sequenceFlow id="f5" sourceRef="credit" targetRef="and_join" />
    <bpmn:sequenceFlow id="f6" sourceRef="docs" targetRef="and_join" />
    <bpmn:sequenceFlow id="f7" sourceRef="and_join" targetRef="decide" />
    <bpmn:sequenceFlow id="f8" sourceRef="decide" targetRef="notify" />
    <bpmn:sequenceFlow id="f9" sourceRef="notify" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_M2_parallel">
    <bpmndi:BPMNPlane id="Plane_M2_parallel" bpmnElement="Process_M2_parallel">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="172" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="156" y="246" width="67" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="receive_di" bpmnElement="receive" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="285" y="185" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="and_split_di" bpmnElement="and_split" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="465" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="credit_di" bpmnElement="credit" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="585" y="65" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="docs_di" bpmnElement="docs" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="585" y="305" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="and_join_di" bpmnElement="and_join" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="765" y="195" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decide_di" bpmnElement="decide" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="885" y="185" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notify_di" bpmnElement="notify" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="1035" y="185" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="1222" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1226" y="243" width="27" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="208" y="220" />
        <di:waypoint x="285" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="395" y="220" />
        <di:waypoint x="465" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="490" y="195" />
        <di:waypoint x="490" y="100" />
        <di:waypoint x="585" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="490" y="245" />
        <di:waypoint x="490" y="340" />
        <di:waypoint x="585" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="695" y="100" />
        <di:waypoint x="790" y="100" />
        <di:waypoint x="790" y="195" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="695" y="340" />
        <di:waypoint x="790" y="340" />
        <di:waypoint x="790" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="815" y="220" />
        <di:waypoint x="885" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
        <di:waypoint x="995" y="220" />
        <di:waypoint x="1035" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9">
        <di:waypoint x="1145" y="220" />
        <di:waypoint x="1222" y="220" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
