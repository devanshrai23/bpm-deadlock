<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_M4_fixed" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_M4_fixed" name="M4 Loan approval - resubmission and coordinated rejection (fixed)" isExecutable="false">
    <bpmn:startEvent id="start" name="Application received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="receive" name="Receive application">
      <bpmn:documentation>time: 5</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="and_split" name="">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="credit" name="Credit check">
      <bpmn:documentation>time: 20</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="loop_join" name="">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="docs" name="Document check">
      <bpmn:documentation>time: 15</bpmn:documentation>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="docs_ok" name="Documents complete?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="request" name="Request missing documents">
      <bpmn:documentation>time: 10</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="received" name="Received in time?">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="failed" name="Mark documents failed">
      <bpmn:documentation>time: 2</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="docs_result" name="">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="and_join" name="">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="decide" name="Make decision">
      <bpmn:documentation>time: 15</bpmn:documentation>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="approved" name="Approved?">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="approve" name="Approve loan">
      <bpmn:documentation>time: 5</bpmn:documentation>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="reject" name="Reject loan">
      <bpmn:documentation>time: 5</bpmn:documentation>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="dec_join" name="">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="notify" name="Notify applicant">
      <bpmn:documentation>time: 3</bpmn:documentation>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Done">
      <bpmn:incoming>f22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive" targetRef="and_split" />
    <bpmn:sequenceFlow id="f3" sourceRef="and_split" targetRef="credit" />
    <bpmn:sequenceFlow id="f4" sourceRef="and_split" targetRef="loop_join" />
    <bpmn:sequenceFlow id="f5" sourceRef="loop_join" targetRef="docs" />
    <bpmn:sequenceFlow id="f6" sourceRef="docs" targetRef="docs_ok" />
    <bpmn:sequenceFlow id="f7" name="Yes" sourceRef="docs_ok" targetRef="docs_result" />
    <bpmn:sequenceFlow id="f8" name="No" sourceRef="docs_ok" targetRef="request" />
    <bpmn:sequenceFlow id="f9" sourceRef="request" targetRef="received" />
    <bpmn:sequenceFlow id="f10" name="Yes" sourceRef="received" targetRef="loop_join" />
    <bpmn:sequenceFlow id="f11" name="No" sourceRef="received" targetRef="failed" />
    <bpmn:sequenceFlow id="f12" sourceRef="failed" targetRef="docs_result" />
    <bpmn:sequenceFlow id="f13" sourceRef="credit" targetRef="and_join" />
    <bpmn:sequenceFlow id="f14" sourceRef="docs_result" targetRef="and_join" />
    <bpmn:sequenceFlow id="f15" sourceRef="and_join" targetRef="decide" />
    <bpmn:sequenceFlow id="f16" sourceRef="decide" targetRef="approved" />
    <bpmn:sequenceFlow id="f17" name="Yes" sourceRef="approved" targetRef="approve" />
    <bpmn:sequenceFlow id="f18" name="No" sourceRef="approved" targetRef="reject" />
    <bpmn:sequenceFlow id="f19" sourceRef="approve" targetRef="dec_join" />
    <bpmn:sequenceFlow id="f20" sourceRef="reject" targetRef="dec_join" />
    <bpmn:sequenceFlow id="f21" sourceRef="dec_join" targetRef="notify" />
    <bpmn:sequenceFlow id="f22" sourceRef="notify" targetRef="end" />
  </bpmn:process>
