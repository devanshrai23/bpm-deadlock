        <di:waypoint x="1115" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1053" y="82" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f8_di" bpmnElement="f8">
        <di:waypoint x="420" y="435" />
        <di:waypoint x="420" y="340" />
        <di:waypoint x="515" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f9_di" bpmnElement="f9">
        <di:waypoint x="625" y="340" />
        <di:waypoint x="665" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f10_di" bpmnElement="f10">
        <di:waypoint x="775" y="340" />
        <di:waypoint x="815" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f11_di" bpmnElement="f11">
        <di:waypoint x="1020" y="125" />
        <di:waypoint x="1020" y="220" />
        <di:waypoint x="1115" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1028" y="164" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f12_di" bpmnElement="f12">
        <di:waypoint x="1225" y="100" />
        <di:waypoint x="1295" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f13_di" bpmnElement="f13">
        <di:waypoint x="1225" y="220" />
        <di:waypoint x="1320" y="220" />
        <di:waypoint x="1320" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f14_di" bpmnElement="f14">
        <di:waypoint x="420" y="485" />
        <di:waypoint x="420" y="580" />
        <di:waypoint x="545" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f15_di" bpmnElement="f15">
        <di:waypoint x="595" y="580" />
        <di:waypoint x="665" y="580" />
