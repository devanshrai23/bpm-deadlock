      <bpmndi:BPMNShape id="fraud_di" bpmnElement="fraud">
        <dc:Bounds x="815" y="305" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="loop_join_di" bpmnElement="loop_join" isMarkerVisible="true">
        <dc:Bounds x="545" y="555" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="docs_di" bpmnElement="docs">
