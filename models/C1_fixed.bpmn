        <di:waypoint x="138" y="460" />
        <di:waypoint x="215" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="325" y="460" />
        <di:waypoint x="395" y="460" />
      </bpmndi:BPMNEdge>
