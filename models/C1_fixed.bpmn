        <dc:Bounds x="845" y="555" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="820" y="523" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="request_di" bpmnElement="request">
        <dc:Bounds x="965" y="665" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="and_join_di" bpmnElement="and_join">
        <dc:Bounds x="1445" y="435" width="50" height="50" />
      </bpmndi:BPMNShape>
