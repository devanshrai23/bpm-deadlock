          <dc:Bounds x="1720" y="403" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve">
        <dc:Bounds x="1865" y="305" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reject_di" bpmnElement="reject">
        <dc:Bounds x="1865" y="545" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="refer_di" bpmnElement="refer">
        <dc:Bounds x="1865" y="665" width="110" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dec_join_di" bpmnElement="dec_join" isMarkerVisible="true">
        <dc:Bounds x="2195" y="435" width="50" height="50" />
      </bpmndi:BPMNShape>
