<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_C1_fixed" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:process id="Process_C1_fixed" name="C1 Loan approval - end-to-end (all defects fixed)" isExecutable="false">
    <bpmn:documentation>resources: officer=1, credit_system=1</bpmn:documentation>
    <bpmn:startEvent id="start" name="Application received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="receive" name="Receive application">
      <bpmn:documentation>time: 5</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="and_split" name="">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="a_credit" name="Open credit system">
      <bpmn:documentation>time: 1; acquire: credit_system</bpmn:documentation>
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a_officer" name="Assign loan officer">
      <bpmn:documentation>time: 2; acquire: officer</bpmn:documentation>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="assess" name="Credit assessment">
      <bpmn:documentation>time: 25; release: officer, credit_system</bpmn:documentation>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="risk" name="Risk level?">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="senior" name="Senior officer review">
      <bpmn:documentation>time: 30</bpmn:documentation>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="auto" name="Automatic scoring">
      <bpmn:documentation>time: 2</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="risk_join" name="">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="b_credit" name="Open credit system (fraud)">
      <bpmn:documentation>time: 1; acquire: credit_system</bpmn:documentation>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="b_officer" name="Assign officer (fraud)">
      <bpmn:documentation>time: 2; acquire: officer</bpmn:documentation>
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="fraud" name="Fraud check">
      <bpmn:documentation>time: 20; release: officer, credit_system</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="loop_join" name="">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="docs" name="Document check">
      <bpmn:documentation>time: 15</bpmn:documentation>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="docs_ok" name="Documents complete?">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="request" name="Request missing documents">
      <bpmn:documentation>time: 10</bpmn:documentation>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="and_join" name="">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="decide" name="Make decision">
      <bpmn:documentation>time: 15</bpmn:documentation>
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="outcome" name="Outcome?">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
      <bpmn:outgoing>f25</bpmn:outgoing>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="approve" name="Approve loan">
      <bpmn:documentation>time: 5</bpmn:documentation>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="reject" name="Reject loan">
      <bpmn:documentation>time: 5</bpmn:documentation>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="refer" name="Refer to manager">
      <bpmn:documentation>time: 5</bpmn:documentation>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:outgoing>f36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="dec_join" name="">
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:incoming>f28</bpmn:incoming>
      <bpmn:incoming>f37</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="notify_split" name="">
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:outgoing>f30</bpmn:outgoing>
      <bpmn:outgoing>f31</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="email" name="Send e-mail">
      <bpmn:documentation>time: 1</bpmn:documentation>
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="sms" name="Send SMS">
      <bpmn:documentation>time: 1</bpmn:documentation>
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="notify_join" name="">
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f34</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="archive" name="Archive case">
      <bpmn:documentation>time: 3</bpmn:documentation>
      <bpmn:incoming>f34</bpmn:incoming>
      <bpmn:outgoing>f35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Done">
      <bpmn:incoming>f35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="manager" name="Manager decision">
      <bpmn:documentation>time: 30</bpmn:documentation>
      <bpmn:incoming>f36</bpmn:incoming>
      <bpmn:outgoing>f37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="receive" />
    <bpmn:sequenceFlow id="f2" sourceRef="receive" targetRef="and_split" />
    <bpmn:sequenceFlow id="f3" sourceRef="and_split" targetRef="a_credit" />
    <bpmn:sequenceFlow id="f4" sourceRef="a_credit" targetRef="a_officer" />
    <bpmn:sequenceFlow id="f5" sourceRef="a_officer" targetRef="assess" />
    <bpmn:sequenceFlow id="f6" sourceRef="assess" targetRef="risk" />
    <bpmn:sequenceFlow id="f7" name="High" sourceRef="risk" targetRef="senior">
      <bpmn:documentation>prob: 0.3</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f8" sourceRef="and_split" targetRef="b_credit" />
    <bpmn:sequenceFlow id="f9" sourceRef="b_credit" targetRef="b_officer" />
    <bpmn:sequenceFlow id="f10" sourceRef="b_officer" targetRef="fraud" />
    <bpmn:sequenceFlow id="f11" name="Low" sourceRef="risk" targetRef="auto">
      <bpmn:documentation>prob: 0.7</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f12" sourceRef="senior" targetRef="risk_join" />
    <bpmn:sequenceFlow id="f13" sourceRef="auto" targetRef="risk_join" />
    <bpmn:sequenceFlow id="f14" sourceRef="and_split" targetRef="loop_join" />
    <bpmn:sequenceFlow id="f15" sourceRef="loop_join" targetRef="docs" />
    <bpmn:sequenceFlow id="f16" sourceRef="docs" targetRef="docs_ok" />
    <bpmn:sequenceFlow id="f17" name="Yes" sourceRef="docs_ok" targetRef="and_join">
      <bpmn:documentation>prob: 0.75</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f18" name="No" sourceRef="docs_ok" targetRef="request">
      <bpmn:documentation>prob: 0.25</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f19" sourceRef="request" targetRef="loop_join" />
    <bpmn:sequenceFlow id="f20" sourceRef="risk_join" targetRef="and_join" />
    <bpmn:sequenceFlow id="f21" sourceRef="fraud" targetRef="and_join" />
    <bpmn:sequenceFlow id="f22" sourceRef="and_join" targetRef="decide" />
    <bpmn:sequenceFlow id="f23" sourceRef="decide" targetRef="outcome" />
    <bpmn:sequenceFlow id="f24" name="Approve" sourceRef="outcome" targetRef="approve">
      <bpmn:documentation>prob: 0.6</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f25" name="Reject" sourceRef="outcome" targetRef="reject">
      <bpmn:documentation>prob: 0.3</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f26" name="Refer" sourceRef="outcome" targetRef="refer">
      <bpmn:documentation>prob: 0.1</bpmn:documentation>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f27" sourceRef="approve" targetRef="dec_join" />
    <bpmn:sequenceFlow id="f28" sourceRef="reject" targetRef="dec_join" />
    <bpmn:sequenceFlow id="f29" sourceRef="dec_join" targetRef="notify_split" />
    <bpmn:sequenceFlow id="f30" sourceRef="notify_split" targetRef="email" />
    <bpmn:sequenceFlow id="f31" sourceRef="notify_split" targetRef="sms" />
    <bpmn:sequenceFlow id="f32" sourceRef="email" targetRef="notify_join" />
    <bpmn:sequenceFlow id="f33" sourceRef="sms" targetRef="notify_join" />
    <bpmn:sequenceFlow id="f34" sourceRef="notify_join" targetRef="archive" />
    <bpmn:sequenceFlow id="f35" sourceRef="archive" targetRef="end" />
    <bpmn:sequenceFlow id="f36" sourceRef="refer" targetRef="manager" />
    <bpmn:sequenceFlow id="f37" sourceRef="manager" targetRef="dec_join" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_C1_fixed">
    <bpmndi:BPMNPlane id="Plane_C1_fixed" bpmnElement="Process_C1_fixed">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="102" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="77" y="410" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
